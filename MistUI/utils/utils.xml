<Ui xmlns="http://www.blizzard.com/wow/ui/">
    <Script file="atlas.lua"/>
    <Script file="core.lua"/>
    <Script file="events.lua"/>
    <Script file="iconframe.lua"/>
    <Script file="nineslice.lua"/>
    <Script file="menu.lua"/>
    <Script file="questpoi.lua"/>
    <Script file="redbutton.lua"/>
    <Script file="forever_ui_base.lua"/>
    <Script file="forever_atlas_chrome.lua"/>
    <Script file="forever_atlas_controls.lua"/>
    <Script file="forever_ui_chrome.lua"/>
    <Script file="forever_ui_controls.lua"/>

    <Frame name="MistUINineSlicePanelTemplate" frameLevel="10" setAllPoints="true" virtual="true">
        <Scripts>
            <OnLoad>MistUI_Mixin(self, MistUI_NineSlicePanelMixin); self:OnLoad()</OnLoad>
        </Scripts>
    </Frame>

    <!-- Bar roots take no scripts: one would replace SecureHandlerStateTemplate's OnLoad. -->
    <Frame name="MistUIMainBarTemplate" frameLevel="50" toplevel="true" inherits="SecureHandlerStateTemplate" virtual="true">
        <Size x="526" y="42"/>
        <Anchors>
            <Anchor point="BOTTOM" x="0" y="18"/>
        </Anchors>
        <Frames>
            <!-- Keep both children unnamed: the main bar fader treats unnamed children as decorative art. -->
            <!-- Anchored by SeatBorderArt in mainbars.lua: its offsets need half units, which XML ints can't hold. -->
            <Frame parentKey="BorderArt" frameLevel="52" inherits="MistUINineSlicePanelTemplate">
                <Attributes>
                    <Attribute name="layoutTextureKit" value="ui-hud-actionbar-frame"/>
                    <Attribute name="layoutType" value="UniqueCornersLayout"/>
                </Attributes>
            </Frame>
            <Frame parentKey="Background" frameLevel="1" setAllPoints="true" inherits="MistUINineSlicePanelTemplate">
                <Attributes>
                    <Attribute name="layoutTextureKit" value="ui-hud-actionbar-frame-background"/>
                    <Attribute name="layoutTextureLayer" value="BACKGROUND"/>
                    <Attribute name="layoutType" value="UniqueCornersLayout"/>
                    <Attribute name="ignoreInLayout" type="boolean" value="true"/>
                </Attributes>
            </Frame>
        </Frames>
    </Frame>
</Ui>
